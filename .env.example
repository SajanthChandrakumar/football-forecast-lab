# Provider credentials are required only by authenticated maintenance.
ODDS_API_KEY=your_key_here
MONGO_URI=mongodb+srv://user:password@example.mongodb.net/
CRON_SECRET=replace-with-a-long-random-secret
# Separate admin key for the manual provider-refresh button (optional).
ADMIN_REFRESH_TOKEN=

# Optional provider selection/configuration.
USE_API_FOOTBALL=false
API_FOOTBALL_KEY=your_api_football_key
ODDS_API_UCL2026_SPORT_KEY=soccer_uefa_champs_league
ESPN_UCL2026_SLUG=uefa.champions
UCL_TEAM_FORM_LEAGUE=2
UCL_TEAM_FORM_SEASON=2026
